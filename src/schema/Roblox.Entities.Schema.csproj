<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <Version>1.2.4</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Library containing schema files and all the entities for the Roblox platform.

      Do not use this for production code, this is simply a reference for the schema and entities</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Schema/**" />
    <Content Remove="Entities/*.sql" />

    <EmbeddedResource Include="Schema/**" />
    <EmbeddedResource Include="Entities/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\entities\Roblox.Entities.csproj" />
    <ProjectReference Include="..\mssql\Roblox.Entities.Mssql.csproj" />
    
    <PackageReference Include="Roblox.Data" Version="1.2.4" />
    <PackageReference Include="Roblox.Caching" Version="1.2.4" />
    <PackageReference Include="Roblox.MssqlDatabases" Version="1.2.4" />
    <PackageReference Include="Roblox.Configuration" Version="1.2.4" />
  </ItemGroup>

</Project>
